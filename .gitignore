node_modules/
.DS_Store
*.log
.vscode/
.idea/
dist/
build/
*.tmp
*.cache
coverage/
.amazonq
.venv

# Root-level env files — never commit real secrets
/.env
/.env.local
/.env.development
/.env.production

# frontend/ env files are committed (non-secret URL config only; no credentials)
# frontend/.env.development  — committed (localhost defaults)
# frontend/.env.production   — committed (production URLs; no secrets)
# Secrets (WC keys, JWT key, FTP credentials) live in GitHub Actions secrets only.

# frontend build artifacts
frontend/dist/
frontend/node_modules/

# ---------------------------------------------------------------
# WordPress — wp/ subdirectory (NEVER commit these files)
# ---------------------------------------------------------------
# WordPress core is installed in wp/ on the server, not tracked here.
# Only wp/wp-content/themes/ and wp/wp-content/mu-plugins/ are tracked.

# WordPress core files installed in wp/ — not tracked
wp-admin/
wp-includes/
wp-*.php
xmlrpc.php
license.txt
readme.html

# Track the configuration sample but never the real config
# (wp-*.php above would match wp-config-sample.php — re-include it explicitly)
!wp/wp-config-sample.php

# Sensitive configuration — manually edit on the server, never commit
wp-config.php
wp-config-local.php
wp-config-*.php
!wp/wp-config-sample.php

# WordPress uploads (binary assets; use Media Library, not Git)
wp-content/uploads/

# WordPress object/page cache and generated files
wp-content/cache/
wp-content/upgrade/
wp-content/backup-db/
wp-content/advanced-cache.php
wp-content/wp-cache-config.php

# WordPress content tracked in this repo (wp/wp-content/):
#   wp/wp-content/themes/drywall-toolbox/   — legacy theme (style.css, functions.php, index.php)
#   wp/wp-content/themes/headless-base/     — active minimal headless theme
#   wp/wp-content/mu-plugins/dtb-cors.php   — CORS mu-plugin (auto-loaded)
# All other installed themes and all plugins are installed on the server only.
wp-content/themes/twenty*/
wp-content/themes/yith*/
wp-content/plugins/

# Composer / PHP dependency directories
vendor/

# OS artifacts
Thumbs.db
ehthumbs.db
Desktop.ini

