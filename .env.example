# ─── Shopify Storefront API ────────────────────────────────────────────────────
# Required for Hydrogen to connect to your Shopify store.
# Obtain from Shopify Admin → Apps → Manage private apps → Hydrogen storefront.

# Your Shopify store domain (e.g. your-store.myshopify.com)
PUBLIC_STORE_DOMAIN=your-store.myshopify.com

# Public Storefront API access token (safe to expose in client-side code)
PUBLIC_STOREFRONT_API_TOKEN=your_public_storefront_token_here

# Private Storefront API access token (server-side only, do NOT expose in client)
PRIVATE_STOREFRONT_API_TOKEN=your_private_storefront_token_here

# Storefront API version to use (update when Hydrogen requires a newer version)
PUBLIC_STOREFRONT_API_VERSION=2024-10

# Shopify Storefront ID (used by Hydrogen Analytics)
PUBLIC_STOREFRONT_ID=your_storefront_id_here

# ─── Oxygen Deployment ────────────────────────────────────────────────────────
# SESSION_SECRET must be a cryptographically random string (min 32 chars).
SESSION_SECRET=your_session_secret_here

# ─── Veeqo Integration ────────────────────────────────────────────────────────
# Veeqo OAuth app credentials for inventory/fulfillment integration.
VITE_VEEQO_CLIENT_ID=your_veeqo_client_id_here
VITE_VEEQO_CLIENT_SECRET=your_veeqo_client_secret_here
VITE_VEEQO_REDIRECT_URI=https://your-store.myshopify.com/veeqo/callback

# ─── GitHub Actions secrets required for Oxygen deployment ───────────────────
# Add these in GitHub → Settings → Secrets and variables → Actions:
#
#   Secret name                       Maps to
#   ─────────────────────────         ──────────────────────────────────────────
#   SHOPIFY_STORE_DOMAIN              PUBLIC_STORE_DOMAIN
#   SHOPIFY_STOREFRONT_API_TOKEN      PUBLIC_STOREFRONT_API_TOKEN
#   SHOPIFY_PRIVATE_STOREFRONT_TOKEN  PRIVATE_STOREFRONT_API_TOKEN
#   VEEQO_CLIENT_ID                   VITE_VEEQO_CLIENT_ID
#   VEEQO_CLIENT_SECRET               VITE_VEEQO_CLIENT_SECRET
#   SESSION_SECRET                    SESSION_SECRET
